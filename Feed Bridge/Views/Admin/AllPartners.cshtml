@model IEnumerable<Feed_Bridge.Models.Entities.Partener>

@{
    ViewData["Title"] = "الشراكات";
    ViewData["ActivePage"] = "AllPartners";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">قائمة الشراكات</h1>
    <a asp-action="Create" asp-controller="Partner" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> إضافة شريك جديد
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>اسم الشريك</th>
            <th>صورة الشريك</th>
            <th>رابط التوجيه</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var partner in Model)
            {
                <tr>
                    <td>@partner.Name</td>
                    <td>
                        <img src="@partner.ImageUrl" alt="@partner.ImageUrl" style="width:100px; height:auto;" />
                    </td>
                    <td>@partner.RedirectUrl</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">لا توجد شراكات</td>
            </tr>
        }
    </tbody>
</table>
