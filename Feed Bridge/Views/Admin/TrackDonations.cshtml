@using Feed_Bridge.Models.Enums
@model IEnumerable<Feed_Bridge.Models.Entities.Donation>

@{
    ViewData["Title"] = "تتبع التبرعات";
    Layout = "_AdminLayout"; // لو عندك Layout خاص بالادمن
}

<h2 class="mb-4">📦 تتبع التبرعات</h2>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th>رقم التبرع</th>
                <th>الدليفري</th>
                <th>تاريخ التعيين</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var donation in Model)
                {
                    <tr>
                        <td>
                            #@donation.Id
                        </td>
                        <td>
                            @if (donation.Delivery != null)
                            {
                                <a asp-action="Profile" asp-controller="User" asp-route-id="@donation.Delivery.Id" class="text-decoration-none">
                                    <i class="bi bi-person-circle"></i> @donation.Delivery.UserName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">لم يُحدد بعد</span>
                            }
                        </td>
                        <td>
                            @if (donation.UpdatedAt != null)
                            {
                                @donation.UpdatedAt.ToString()
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @switch (donation.Status)
                            {
                                case DonationStatus.Assigned:
                                    <span class="badge bg-warning text-dark">قيد التوصيل</span>
                                    ;
                                    break;
                                case DonationStatus.Delivered:
                                    <span class="badge bg-success">تم الاستلام</span>
                                    ;
                                    break;
                                case DonationStatus.Accepted:
                                    <span class="badge bg-primary">موافق عليه ولم يتم اخذه من قبل موصل </span>
                                    ;
                                    break;
                                default:
                                    <span class="badge bg-secondary">@donation.Status</span>
                                    ;
                                    break;
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-muted text-center">لا يوجد بيانات متاحة</td>
                </tr>
            }
        </tbody>
    </table>
</div>