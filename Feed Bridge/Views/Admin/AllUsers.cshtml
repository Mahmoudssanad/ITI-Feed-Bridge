@model IEnumerable<Feed_Bridge.ViewModel.UserWithRoleVM>

@{
    ViewData["Title"] = "المستخدمين";
    ViewData["ActivePage"] = "AllUsers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">قائمة المستخدمين</h1>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>اسم المستخدم</th>
            <th>البريد الإلكتروني</th>
            <th>الدور</th>
            <th>صورة الملف الشخصي</th>
            <th>تغيير الدور</th>
             <th>الحالة</th>

        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@(user.Roles.Any() ? string.Join(", ", user.Roles) : "User")</td>

                    <td>
                        <img src="@(string.IsNullOrEmpty(user.ImgUrl)
                                                             ? Url.Content("~/imgs/person.png")
                                                             : Url.Content(user.ImgUrl))"
                     alt="@user.UserName"
                     style="width:50px;height:50px;object-fit:cover;" />
            </td>

                    <td>
                @if (!(user.Roles.Contains("Admin") || user.Roles.Contains("Delivery")))
                        {
                            <form asp-action="ChangeUserRole" asp-controller="Admin" method="post" class="d-flex">
                                <input type="hidden" name="userId" value="@user.UserId" />

                                <select name="newRole" class="form-select form-select-sm me-2">
                                    <option value="User" selected="@(user.Roles.Contains("User") ? "selected" : null)">User</option>
                                    <option value="Delivery" selected="@(user.Roles.Contains("Delivery") ? "selected" : null)">Delivery</option>
                                    <option value="Admin" selected="@(user.Roles.Contains("Admin") ? "selected" : null)">Admin</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-primary" style="background-color:#1cba7f; border:none;">
                                    تحديث
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">غير قابل للتغيير</span>
                        }
                    </td>
                    <td>
                        @if (user.Roles.Contains("Admin"))
                        {
                            <span class="text-muted">غير قابل للتجميد</span>
                        }
                        else
                        {
                            <form asp-action="ToggleFreeze" asp-controller="Admin" method="post">
                                <input type="hidden" name="userId" value="@user.UserId" />

                                @* @if (user.IsFrozen) *@
                                @* { *@
                                @*     <button type="submit" class="btn btn-sm btn-success"> *@
                                @*         إلغاء التجميد *@
                                @*     </button> *@
                                @* } *@
                                @* else *@
                                @* { *@
                                @*     <button type="submit" class="btn btn-sm btn-danger"> *@
                                @*         تجميد *@
                                @*     </button> *@
                                @* } *@
                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">لا يوجد مستخدمين</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const successMessage = "@TempData["SuccessMessage"]";
        if (successMessage && successMessage.trim() !== "") {
            Swal.fire({
                icon: 'success',
                title: 'نجاح!',
                text: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        const errorMessage = "@TempData["ErrorMessage"]";
        if (errorMessage && errorMessage.trim() !== "") {
            Swal.fire({
                icon: 'error',
                title: 'خطأ!',
                text: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
}