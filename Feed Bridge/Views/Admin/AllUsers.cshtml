@model IEnumerable<Feed_Bridge.ViewModel.UserWithRoleVM>

@{
    ViewData["Title"] = "المستخدمين";
    ViewData["ActivePage"] = "AllUsers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">قائمة المستخدمين</h1>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>اسم المستخدم</th>
            <th>البريد الإلكتروني</th>
            <th>الدور</th>
            <th>صورة الملف الشخصي</th>
            <th>تغيير الدور</th>
            <th>الحالة</th>
            <th>حذف</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var user in Model.Where(u => !u.Roles.Contains("Admin")))
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@(user.Roles.Any() ? string.Join(", ", user.Roles) : "User")</td>

                    <td>
                        <img src="@(string.IsNullOrEmpty(user.ImgUrl)
                                                             ? Url.Content("~/imgs/person.png")
                                                             : Url.Content(user.ImgUrl))"
                        alt="@user.UserName"
                        style="width:50px;height:50px;object-fit:cover;" />
                    </td>
                    <td>
                        @if (!(user.Roles.Contains("Admin") ))
                        {
                            <form asp-action="ChangeUserRole" asp-controller="Admin" method="post" class="d-flex">
                                <input type="hidden" name="userId" value="@user.UserId" />

                                <select name="newRole" class="form-select form-select-sm me-2">
                                    <option value="User" selected="@(user.Roles.Contains("User") ? "selected" : null)">User</option>
                                    <option value="Delivery" selected="@(user.Roles.Contains("Delivery") ? "selected" : null)">Delivery</option>
                                    <option value="Admin" selected="@(user.Roles.Contains("Admin") ? "selected" : null)">Admin</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-primary" style="background-color:#1cba7f; border:none;">
                                    تحديث
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">غير قابل للتغيير</span>
                        }
                    </td>
                    <td>
                        @if (user.Roles.Contains("Admin"))
                        {
                            <span class="text-muted">غير قابل للتجميد</span>
                        }
                        else
                        {
                            <button type="button"
                            class="btn btn-sm @(user.IsFrozen ? "btn-success" : "btn-danger") toggle-freeze-btn"
                            data-user-id="@user.UserId">
                                @(user.IsFrozen ? "إلغاء التجميد" : "تجميد")
                            </button>
                        }
                    </td>
                    <td>
                        @if (user.IsDeleted)
                        {
                            if (user.DeletedBy == "User")
                            {
                                 <span class="badge bg-success">تم حذف الحساب بواسطة المستخدم</span> 
                            }
                            else if (user.DeletedBy == "Admin")
                            {
                                <span class="badge bg-danger">تم حذف الحساب بواسطة الإدارة</span>
                            }
                        }
                        else
                        {
                            <form asp-action="DeleteUser" asp-controller="Admin" asp-route-id="@user.UserId" method="post">
                                <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">لا يوجد مستخدمين</td>
            </tr>
        }
    </tbody>
</table>



@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        const successMessage = "@TempData["SuccessMessage"]";
        if (successMessage && successMessage.trim() !== "") {
            Swal.fire({
                icon: 'success',
                title: 'نجاح!',
                text: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        const errorMessage = "@TempData["ErrorMessage"]";
        if (errorMessage && errorMessage.trim() !== "") {
            Swal.fire({
                icon: 'error',
                title: 'خطأ!',
                text: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
    <script>
                $(document).on("click", ".toggle-freeze-btn", function () {
            var button = $(this);
            var userId = button.data("user-id");

            // هات التوكين
            var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

            $.ajax({
                type: "POST",
                url: "@Url.Action("ToggleFreeze", "Admin")",
                data: {
                    userId: userId,
                    __RequestVerificationToken: token  // لازم يتبعت
                },
                success: function (response) {
                    if (response.success) {
                        if (response.isFrozen) {
                            button.removeClass("btn-danger").addClass("btn-success");
                            button.text("إلغاء التجميد");
                        } else {
                            button.removeClass("btn-success").addClass("btn-danger");
                            button.text("تجميد");
                        }

                        Swal.fire({
                            icon: 'success',
                            title: 'نجاح!',
                            text: response.message,
                            showConfirmButton: false,
                            timer: 2000
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ!',
                            text: response.message,
                            showConfirmButton: false,
                            timer: 2000
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ في الاتصال',
                        text: 'تعذر تنفيذ العملية حالياً',
                        showConfirmButton: false,
                        timer: 2000
                    });
                }
            });
        });

    </script>
}

