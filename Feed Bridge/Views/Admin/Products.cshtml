@model IEnumerable<Feed_Bridge.Models.Entities.Product>

@{
    ViewData["Title"] = "المنتجات";
    ViewData["ActivePage"] = "Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">قائمة المنتجات</h1>

<table class="table table-hover table-bordered text-center">
    <thead class="table-dark">
        <tr>
            <th>الاسم</th>
            <th>تاريخ التبرع</th>
            <th>تاريخ الانتهاء</th>
            <th>الكمية</th>
            <th>الصورة</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.CreatedAt.ToShortDateString()</td>
                    <td>@product.ExpirDate.ToShortDateString()</td>
                    <td>@product.Quantity</td>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ImgURL))
                        {
                            <img src="@Url.Content("~/uploads/" + product.ImgURL)"
                                 alt="@product.Name"
                                 style="width:50px;height:50px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/imgs/Empty.png"
                                 alt="صورة افتراضية"
                                 style="width:50px;height:50px;object-fit:cover;" />
                        }
                    </td>
                    <td>
                        <form asp-action="DeleteProduct" asp-controller="Admin" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@product.Id" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('هل أنت متأكد من حذف هذا المنتج؟')">
                                🗑️ حذف
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">لا توجد منتجات</td>
            </tr>
        }
    </tbody>
</table>
