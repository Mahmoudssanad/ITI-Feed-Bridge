@using Feed_Bridge.Models.Enums
@model Feed_Bridge.Models.Entities.Order

<div class="container mt-5">
    <div class="order-card shadow-sm p-4 rounded">
        <!-- Order Header -->
        <div class="text-center mb-4">
            <h2 class="fw-bold text-success">📝 تفاصيل الطلب رقم @Model.Id</h2>
            <p><strong>الحالة:</strong> <span class="status-text">@Model.Status</span></p>
            <p><strong>تاريخ الإنشاء:</strong> @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
        </div>

        <!-- Order Products Table -->
        <table class="table table-hover text-center align-middle">
            <thead class="table-success">
                <tr>
                    <th>الصورة</th>
                    <th>اسم المنتج</th>
                    <th>الكمية</th>
                    <th>الحاله</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderProducts)
                {
                    <tr>
                        <td>
                            <img src="~/uploads/@(item.Product?.ImgURL ?? "img.png")"
                                 alt="@item.Product?.Name"
                                 class="product-img" />
                        </td>
                        <td>@item.Product?.Name</td>
                        <td class="fw-bold">@item.Quantity</td>
                        <td>
                        @*     @if (item.Status == OrderStatus.Pending) *@
                        @*     { *@
                        @*         <span class="badge bg-warning">قيد المراجعة</span> *@
                        @*     } *@
                        @*     else if (order.Status == OrderStatus.Approved) *@
                        @*     { *@
                        @*         <span class="badge bg-success">تمت الموافقة</span> *@
                        @*     } *@
                        @*     else if (order.Status == OrderStatus.Rejected) *@
                        @*     { *@
                        @*         <span class="badge bg-danger">مرفوض</span> *@
                        @*     } *@
                        @*     else if (order.Status == OrderStatus.Assigned) *@
                        @*     { *@
                        @*         <span class="badge bg-primary">قيد التوصيل</span> *@
                        @*     } *@
                        @*     else if (order.Status == OrderStatus.Delivered) *@
                        @*     { *@
                        @*         <span class="badge bg-dark">تم التوصيل</span> *@
                        @*     } *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    <div class="text-center mt-4">
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
            ⬅️ عودة للمنتجات
        </a>
       
    </div>
</div>
